# InstaRetriv AI configuration template.
# Copy to .env for local development:  copy .env.example .env  (or cp on macOS/Linux)
# Never commit .env. In production (Render) set these in the service's Environment tab.
# Secrets are intentionally blank here.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=InstaRetriv AI
# development | test | production
#   development: auto-reload in run.py, API docs on, JSON/local fallbacks allowed (with warnings)
#   production : Twilio signature always enforced, no silent fallbacks, API docs off by default
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Signs dashboard sessions and short-lived /files links. REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random per-process secret is used (sessions/links break on restart).
APP_SECRET_KEY=

# Public HTTPS base URL of this app (no trailing slash), used for signed file links
# and the Twilio status callback. Examples: https://instaretriv-ai.onrender.com
# or your ngrok URL. If empty, it is derived from the incoming request.
PUBLIC_BASE_URL=

# Show /docs, /redoc and /openapi.json. Leave commented out for the default
# (on outside production, off in production). Set true/false to override.
# ENABLE_API_DOCS=

# ---------------------------------------------------------------------------
# Dashboard login
# ---------------------------------------------------------------------------
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
# No default password: the login form stays disabled until this is set.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_TTL_MINUTES=720
# Failed logins per client IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# WhatsApp senders allowed to use the bot
# ---------------------------------------------------------------------------
# Comma-separated, e.g. whatsapp:+911234567890,whatsapp:+919876543210
# Empty: any sender is allowed in development; in production EVERY sender is
# rejected unless ALLOW_ANY_SENDER=true (not recommended for a personal vault).
AUTHORIZED_SENDERS=
ALLOW_ANY_SENDER=false

# ---------------------------------------------------------------------------
# Twilio WhatsApp
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: secondary token, accepted for signature checks during token rotation.
TWILIO_SECONDARY_AUTH_TOKEN=
# Twilio sandbox sender by default; replace with your approved sender later.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Extra attempts for transient Twilio send errors (4xx errors are never retried).
TWILIO_SEND_RETRIES=2
# Validate X-Twilio-Signature on /webhook and /webhook/status.
# Always enforced when APP_ENV=production, whatever this says.
REQUIRE_TWILIO_SIGNATURE=false

# ---------------------------------------------------------------------------
# Private documents (WhatsApp YES/1 confirmation)
# ---------------------------------------------------------------------------
# How long the user has to confirm a private document (minimum 15 seconds).
PRIVATE_CONFIRMATION_TTL_SECONDS=45
PRIVATE_CONFIRMATION_YES_KEYWORDS=yes,y,ok,confirm,1,haan,ha
PRIVATE_CONFIRMATION_CANCEL_KEYWORDS=no,n,cancel,stop,0
# Lifetime of signed /files links sent to Twilio and opened from the dashboard.
FILE_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# File storage: local | cloudinary
# ---------------------------------------------------------------------------
# local is fine for development. Use cloudinary in production (Render's disk is
# wiped on every deploy/restart).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,doc,docx
# WhatsApp media limit is 16 MB.
MAX_UPLOAD_MB=15
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Metadata and request logs: json | mongo
# ---------------------------------------------------------------------------
# json is fine for development. Use mongo in production.
METADATA_BACKEND=json
METADATA_FILE=data/metadata.json
REQUEST_LOG_FILE=data/request_logs.json
REQUEST_LOG_MAX_ENTRIES=2000
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=instaretriv_ai
MONGODB_COLLECTION=documents
MONGODB_REQUEST_LOG_COLLECTION=request_logs
MONGODB_TIMEOUT_MS=5000
# How often to retry connecting to an unavailable metadata store.
METADATA_STORE_RETRY_SECONDS=30
